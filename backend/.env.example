# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/krisgen?retryWrites=true&w=majority

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=krisgen_token

# Commission defaults (percentages, admin can override per-product/platform via Settings)
DEFAULT_DIRECT_COMMISSION_RATE=15
DEFAULT_REFERRAL_OVERRIDE_RATE=5

# Payment provider (Flutterwave)
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
FLW_ENCRYPTION_KEY=xxxxxxxx
FLW_VERIFY_URL=https://api.flutterwave.com/v3/transactions
# Webhook: the same string goes in Flutterwave dashboard > Settings > Webhooks > Secret hash
FLW_SECRET_HASH=replace-with-a-long-random-string

# Password-reset emails (Resend). Leave unset locally; in development the link is printed to the console.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Krisgen <no-reply@yourdomain.com>

# Cloudinary (product image uploads; keep the API secret on the backend only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed admin (used only by seed script; the password needs at least 12 characters)
SEED_ADMIN_EMAIL=admin@krisgen.com
SEED_ADMIN_PASSWORD=changeMe123!

# Optional: only if your network cannot resolve mongodb+srv addresses (seed script)
# DNS_SERVERS=8.8.8.8,8.8.4.4
